# 默认保持离线，程序不会发起任何模型或搜索请求。
NOVEL_AGENT_MODE=offline
NOVEL_AGENT_DATABASE=data/novel_agent.db
NOVEL_AGENT_HOST=127.0.0.1
NOVEL_AGENT_PORT=8000

# 内置 Story Skills 一致性审校。离线模式只运行本地确定性检查；
# 在线模式会在每次章节审核/修订循环中额外调用一次 LLM。
STORY_SKILLS_ENABLED=true

# oh-story 写作质量 Skill：情绪细纲、题材提示卡与写后去 AI 味。
# 在线模式下每个初稿会额外增加一次 DeepSeek 润色请求。
OH_STORY_ENABLED=true

# 当你准备接入模型时再填写。不要把真实密钥提交到版本库。
# DeepSeek 推荐配置：provider=deepseek、base_url=https://api.deepseek.com、
# model=deepseek-v4-pro。程序也接受 DEEPSEEK_API_KEY 作为密钥变量别名。
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Tavily 搜索与网页正文读取
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_TIMEOUT_SECONDS=30
SEARCH_MAX_RESULTS=3

# SiliconFlow Embedding（DeepSeek 密钥不能用于此接口）
EMBEDDING_PROVIDER=disabled
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60
SEMANTIC_RETRIEVAL_LIMIT=6

# PostgreSQL / Redis / 对象存储均为后续生产能力，离线版不需要。
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=novel-agent

# 未来发布平台适配器；当前只允许 mock。
PUBLISHER_PROVIDER=mock
PUBLISHER_API_KEY=
PUBLISHER_BASE_URL=
